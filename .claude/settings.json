{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "https://anthropic.generative.engine.capgemini.com",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_MODEL": "claude-haiku-4-5-20251001"
  },
  "theme": "dark",
  "hasCompletedProjectOnboarding": true,
  "hasTrustDialogAccepted": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [[ \"$f\" =~ \\.vue$ ]]; then (cd \"$(git rev-parse --show-toplevel)/ui\" && npm run format -- \"$f\" && npm run lint -- \"$f\") || exit 2; fi; }",
            "statusMessage": "Formatting and linting Vue file...",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
