# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=task_manager
MYSQL_USER=taskuser
MYSQL_PASSWORD=taskpass
MYSQL_PORT=3307
DB_HOST=127.0.0.1

# Backend Configuration
BACKEND_PORT=8080
# Note: When running in Docker Compose, use 'mysql' as hostname instead of localhost
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/task_manager
SPRING_DATASOURCE_USERNAME=taskuser
SPRING_DATASOURCE_PASSWORD=taskpass

# OAuth Configuration (dev placeholders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for OAuth2 Redirect
# Local dev: http://localhost:5173 (Vite dev server)
# Docker: http://localhost:8000 (Nginx reverse proxy)
APP_FRONTEND_URL=http://localhost:5173

# CORS Configuration (allowed origins for backend)
# Local dev: http://localhost:5173 (Vite dev server) + http://localhost:3000 (alt dev port)
# Docker: http://localhost:8000 (Nginx reverse proxy)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
