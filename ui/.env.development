# Development environment - local backend with Vite proxy
# IMPORTANT: Use relative path /api so Vite proxy intercepts and forwards to http://localhost:8080
# Do NOT use absolute http://localhost:8080 - that bypasses proxy and CORS fails
# If you need to override, use: VITE_API_URL=/api

# Leave VITE_API_URL unset to use /api default from client.ts
# Or set explicitly:
VITE_API_URL=http://localhost:8080/api 

# WebSocket will be proxied by Vite to ws://localhost:8080/api/ws
VITE_WS_URL=/api/ws
