# Development environment - local backend with Vite proxy
# IMPORTANT: Use relative path /api so Vite proxy intercepts and forwards to http://localhost:8080
# Do NOT use absolute URLs - that bypasses proxy and breaks CORS + credentials

# Relative path - Vite proxy will intercept and forward to backend
VITE_API_URL=/api

# WebSocket will be proxied by Vite to ws://localhost:8080/api/ws
VITE_WS_URL=/api/ws
