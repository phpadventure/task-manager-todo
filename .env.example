# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=task_manager
MYSQL_USER=taskuser
MYSQL_PASSWORD=taskpass
MYSQL_PORT=3306

# Backend Configuration
BACKEND_PORT=8080
# Note: When running in Docker Compose, use 'mysql' as hostname instead of localhost(or direct IP 127.0.0.1). Eposed port for local use is 3307.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/task_manager
SPRING_DATASOURCE_USERNAME=taskuser
SPRING_DATASOURCE_PASSWORD=taskpass

# OAuth Configuration (add these when setting up SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CORS Configuration (allowed origins for backend)
# Local dev: http://localhost:5173 (Vite dev server) + http://localhost:3000 (alt dev port)
# Docker: http://localhost (Nginx reverse proxy)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
